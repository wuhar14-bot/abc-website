# Copy this file to .env.local and fill in your own keys.
# .env.local is gitignored — never commit real keys.

# --- Stripe ---
# Dashboard: https://dashboard.stripe.com  (Developers -> API keys)
# Use pk_test_ / sk_test_ while developing. Switch to pk_live_ / sk_live_
# only after your account is verified and you're ready to take real money.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx

# Base URL used to build Stripe success/cancel redirect links.
# Local dev: http://localhost:3000
# Production: https://anythingbutclimbing.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin order desk. Use a long random value and add it to Vercel Production.
# Open https://anythingbutclimbing.com/admin/orders and enter this token.
ADMIN_DASHBOARD_TOKEN=replace-with-a-long-random-token

# Order confirmation email (Resend). Use a verified sending domain/address.
RESEND_API_KEY=re_xxx
ORDER_FROM_EMAIL=AnythingButClimbing <orders@anythingbutclimbing.com>

# --- Optional future phase (webhook -> database order storage) ---
# STRIPE_WEBHOOK_SECRET=whsec_xxx
